# Copy to .env.local and fill in. Same values go into Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Any long random string — used to sign caller session cookies
CALLER_SESSION_SECRET=

# Passphrase for the admin console. Leave blank and the console is open to
# anyone with the link; a red banner will say so on every admin page.
ADMIN_PASSWORD=

# Anthropic (console.anthropic.com) — powers "What to Attack Today" and dialer approach tips
ANTHROPIC_API_KEY=

# Google Cloud → Places API (New) — used only by scripts/, not the web app
GOOGLE_PLACES_API_KEY=

# SignalHire — used only by scripts/enrich-leads.mjs
SIGNALHIRE_API_KEY=

# --- Call recording (optional) -------------------------------------------
# Recording itself needs no keys: it captures the room through the caller's
# laptop microphone. Switch it on at Admin -> Recording.
#
# Transcription DOES need a paid provider — Anthropic has no speech-to-text.
# Leave these unset and recordings are still saved and playable, just not
# written out as text.
# TRANSCRIPTION_PROVIDER=deepgram   # or: openai
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
#
# Reading the transcript afterwards uses ANTHROPIC_API_KEY, which is already
# set above for the prioritiser. Without it, recordings and transcripts still
# work — the deterministic reading from the outcome form stands, and the call
# is recorded as decided by the form rather than by the model.

# --- Cold email, through Instantly (optional) -----------------------------
# Instantly SENDS the email. This app decides who gets it — using the owner's
# name, the review count and what a caller learned on the phone — and catches
# every reply so none of them sit unread in a separate tool.
#
# Nothing is pushed until an administrator switches the programme on at
# Admin -> Email, and no reply is ever answered without a person unless
# "Answer clear replies without me" is deliberately turned on there.
#
# The v2 API key, from Instantly -> Settings -> Integrations.
# INSTANTLY_API_KEY=
#
# A shared secret you invent. Put the SAME value on the webhook in Instantly,
# in an "x-instantly-secret" header. Until this is set, the webhook endpoint
# rejects everything and no replies reach you — which is deliberate: an open
# endpoint that writes rows keyed by an email address is an invitation to
# unsubscribe somebody else's leads.
# INSTANTLY_WEBHOOK_SECRET=
#
# Only if Instantly ever moves the API. The default is correct.
# INSTANTLY_API_BASE=https://api.instantly.ai/api/v2
#
# Writing sequences uses ANTHROPIC_API_KEY, already set above for the
# prioritiser. Without it the Email page still works — you just write the
# sequence yourself in Instantly instead of describing it.
