# Copy to .env.local and fill in. Same values go into Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Any long random string — used to sign caller session cookies
CALLER_SESSION_SECRET=

# Passphrase for the admin console. Leave blank and the console is open to
# anyone with the link; a red banner will say so on every admin page.
ADMIN_PASSWORD=

# Anthropic (console.anthropic.com) — powers "What to Attack Today" and dialer approach tips
ANTHROPIC_API_KEY=

# Google Cloud → Places API (New) — used only by scripts/, not the web app
GOOGLE_PLACES_API_KEY=

# SignalHire — used only by scripts/enrich-leads.mjs
SIGNALHIRE_API_KEY=

# --- Call recording (optional) -------------------------------------------
# Recording itself needs no keys: it captures the room through the caller's
# laptop microphone. Switch it on at Admin -> Recording.
#
# Transcription DOES need a paid provider — Anthropic has no speech-to-text.
# Leave these unset and recordings are still saved and playable, just not
# written out as text.
# TRANSCRIPTION_PROVIDER=deepgram   # or: openai
# DEEPGRAM_API_KEY=
# OPENAI_API_KEY=
