# Copy to .env.local and fill in. Same values go into Vercel → Settings → Environment Variables.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Any long random string — used to sign caller session cookies
CALLER_SESSION_SECRET=

# Anthropic (console.anthropic.com) — powers "What to Attack Today" and dialer approach tips
ANTHROPIC_API_KEY=

# Google Cloud → Places API (New) — used only by scripts/, not the web app
GOOGLE_PLACES_API_KEY=

# SignalHire — used only by scripts/enrich-leads.mjs
SIGNALHIRE_API_KEY=
